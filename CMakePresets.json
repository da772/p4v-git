{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-clang-ninja",
      "displayName": "Linux Clang Ninja",
      "description": "Configure on Linux with Clang, clang++, and the Ninja generator.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-clang-ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-clang-ninja",
      "displayName": "Linux Clang Ninja",
      "description": "Build the Linux Clang/Ninja tree with parallel jobs.",
      "configurePreset": "linux-clang-ninja",
      "jobs": 16
    }
  ]
}
